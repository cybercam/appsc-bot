# ───────────────────────────────────────────────────────────────
# APPSC Group-1 Revision Bot — environment configuration
# Copy to `.env` and fill in. NEVER commit the real .env.
# ───────────────────────────────────────────────────────────────

# From @BotFather (https://t.me/BotFather) -> /newbot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_token_here

# Path to the Google service-account JSON key file.
# Locally: a file path. On Railway/Render: see README (write the JSON to a file at boot).
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# The Google Sheet that is the bot's database (the ID from the sheet URL).
SHEET_ID=1Uy8N8Ea_CK3wFZ-clL67taEU-hV-ElM3-t5_n15H5Zg

# Worksheet (tab) name within that spreadsheet.
WORKSHEET_NAME=Sheet1

# Scheduling timezone (IANA name) and the hour (0-23) for daily delivery.
TIMEZONE=Asia/Kolkata
DAILY_REVIEW_HOUR=7

# Comma-separated chat IDs allowed to use the bot. LEAVE BLANK to allow
# anyone who runs /start. Find your ID by messaging @userinfobot.
# Example: AUTHORIZED_CHAT_IDS=123456789,987654321
AUTHORIZED_CHAT_IDS=

# Optional overrides (sensible defaults exist):
# CHAT_IDS_FILE=chat_ids.json
# LOG_LEVEL=INFO
# LOG_FILE=logs/bot.log
